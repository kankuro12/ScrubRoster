APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_SOCKET=/var/run/mysqld/mysqld.sock
# DB_HOST=localhost
# DB_PORT=3306
DB_DATABASE=cleanway_db
DB_USERNAME=cleanway_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Admin seeder credentials (AdminUserSeeder)
ADMIN_EMAIL=admin@cleanway.local
ADMIN_PASSWORD=password

# Audit
AUDIT_ENABLED=true
AUDIT_QUEUE=false

# Firebase Cloud Messaging (FCM push notifications)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
# FIREBASE_WEB_ACTION_URL=/admin/notifications

# Firebase web app config (public client values)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=
FIREBASE_VAPID_KEY=

# Google Places / Geocoding (backend-only key, never exposed to JS)
GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_API_URL=https://maps.googleapis.com/maps/api
# GOOGLE_PLACES_REGION=nz
# GOOGLE_PLACES_TIMEOUT=8

# Organization-wide settings
ORGANIZATION_NAME=CleanWay
DEFAULT_CHECK_IN_RADIUS_METERS=150

# GPS / geofence policies (can be overridden at runtime via Settings UI)
GPS_MAX_ACCURACY_METERS=50
GPS_OUT_OF_RADIUS_POLICY=exception
GPS_MISSING_COORDINATES_POLICY=override
GPS_REQUIRE_CHECKOUT=false
TASK_REQUIRE_COMPLETION_REMARKS=true
TASK_REQUIRE_INCIDENT_ACK=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sahakari / Private mode (false = private customer-wise billing)
USE_SAHAKARI=false

VITE_APP_NAME="${APP_NAME}"

ASSET_VERSION=1.0.0
